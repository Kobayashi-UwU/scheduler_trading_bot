NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_FALLBACK_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_SEC=180
NVIDIA_MAX_TOKENS=3000
NVIDIA_RETRY_BACKOFF_CAP_SEC=30

SYMBOL=GC=F
FALLBACK_SYMBOL=XAUUSD=X
ANALYSIS_INTERVAL_MIN=15
PRICE_CHECK_INTERVAL_MIN=1

START_BALANCE=10000
RISK_PER_TRADE=0.01
MIN_CONFIDENCE=0.6
MIN_RISK_REWARD=1.5
MAX_OPEN_POSITIONS=1

DASHBOARD_PASSWORD=

# --- real-account tier ---------------------------------------------------------
# A second set of accounts sized like a real broker account instead of the
# idealised paper one. Still a simulation: no live orders are placed.
REAL_ENABLED=true
# Which paper accounts to mirror (comma-separated; must be ai_selected or a strategy name)
REAL_ACCOUNTS=ai_selected,trend_following
REAL_START_BALANCE=100
# Match your broker account's leverage (margin = lots * 100oz * price / leverage).
# Higher leverage does NOT change risk per trade here — risk is set by the stop
# distance — it only lowers the margin locked while a position is open.
REAL_LEVERAGE=2000
# XAUUSD contract: 1.00 lot = 100 troy oz, so min lot 0.01 = 1 oz
REAL_CONTRACT_SIZE=100
REAL_MIN_LOT=0.01
REAL_LOT_STEP=0.01
REAL_MAX_LOT=100
REAL_RISK_PER_TRADE=0.01
# NOTE: at 0.01 lot the smallest possible loss is the stop distance in dollars
# (~$7-25 on gold), which is 7-25% of a $100 account — REAL_RISK_PER_TRADE above
# is unreachable and sizing floors at the minimum lot. This cap is the ceiling on
# that overshoot; signals needing more are skipped and logged to /api/real/skips.
# Lower it to trade less often but risk less per trade.
REAL_MAX_RISK_PCT=0.30

# --- cTrader executor -----------------------------------------------------------
# Mirrors the real-tier sim positions onto live cTrader accounts (e.g. Axiory)
# via the Open API (protobuf over TLS TCP — no container/terminal process, unlike
# the old MT5/Wine approach). Off by default. Access/refresh tokens are NOT env
# vars — see app/db/models.py BrokerToken and scripts/ctrader_oauth_setup.py.
EXECUTOR_ENABLED=false
EXECUTOR_SYNC_INTERVAL_MIN=1
# Broker's gold symbol name as listed by ProtoOASymbolsListReq.
EXECUTOR_SYMBOL=XAUUSD
EXECUTOR_MAX_OPEN_AGE_MIN=30

# Spotware Open API application credentials from https://openapi.ctrader.com/apps
# (one app can authorize multiple trading accounts). Put real values ONLY in
# Railway variables, never in the repo.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ENVIRONMENT=demo
CTRADER_TOKEN_REFRESH_MARGIN_DAYS=3

# JSON mapping real-tier account -> cTrader account id (single line). Run
# scripts/ctrader_oauth_setup.py first to discover ctidTraderAccountId values and
# seed the matching BrokerToken rows in the DB:
# EXECUTOR_ACCOUNTS={"real_ai_selected": {"ctid_trader_account_id": 8068629}, "real_trend_following": {"ctid_trader_account_id": 8068630}}
EXECUTOR_ACCOUNTS=

# Local dev default (SQLite). On Railway, set this to the Postgres plugin's
# connection string, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./data/trading_bot.db
