#!/usr/bin/with-contenv bash
# linuxserver.io "custom service" (see /custom-services.d docs): runs LAST,
# after every built-in service (KasmVNC/X, and the image's own MT5 autostart
# via /Metatrader/start.sh) is already up -- unlike a raw CMD/entrypoint
# override, which runs *before* any of that and therefore lacks a working
# DISPLAY, the correct user, or a ready Wine prefix (confirmed the hard way:
# every "wine python" call failed with "ShellExecuteEx failed: File not
# found" when attempted pre-init). s6 supervises this as a long-running
# service and restarts it if it ever exits.
#
# start.sh's own final step (python3 -m mt5linux ... -w wine python.exe)
# never works: its unpinned "pip install mt5linux>=0.1.9" resolves to the
# latest release, which dropped the "-w" flag that command depends on. Rather
# than fight that version drift, this starts the actual rpyc bridge directly:
# a plain SlaveService running under Wine's python (so "import MetaTrader5"
# succeeds), which is exactly what the mt5linux CLIENT side (rpyc.classic.
# connect + "import MetaTrader5 as mt5") expects on the other end.
#
# start.sh's own "pip install MetaTrader5==5.0.36" pulls in numpy unpinned
# ("numpy>=1.7"), which resolves to the latest 2.x -- but the MetaTrader5
# wheel's compiled extension was built against numpy 1.x's ABI, so any
# "import MetaTrader5" under it fails immediately with "AttributeError:
# _ARRAY_API not found" (confirmed directly: the bridge accepted a
# connection and bound the port fine, but the remote "import MetaTrader5"
# the mt5linux client triggers crashed with exactly this). Downgrading here,
# after start.sh's own install, is the only lever available short of
# patching start.sh itself.

# start.sh (this image's own MT5 autostart) does its own Wine/MT5/Python
# setup concurrently with this service starting. Running "wine python" while
# that's still in progress races the wineserver during prefix initialization
# -- observed directly as "wine: could not load kernel32.dll" -- so wait out
# the whole sequence (observed to reliably finish within ~110s, whether
# freshly installing or just re-launching an already-installed prefix) before
# touching wine at all. A fixed wait, not a file/process check: exact Wine
# install paths are Windows-side and unreliable to probe from Linux.
sleep 180

s6-setuidgid abc wine python -m pip install --no-cache-dir "numpy<2" 2>&1

i=0
while [ $i -lt 60 ]; do
  s6-setuidgid abc wine python -c "import rpyc, MetaTrader5" 2>/dev/null && break
  i=$((i + 1))
  sleep 5
done

exec s6-setuidgid abc wine python -c "
import rpyc
from rpyc.utils.server import ThreadedServer
from rpyc.core.service import SlaveService
ThreadedServer(
    SlaveService,
    hostname='0.0.0.0',
    port=8001,
    reuse_addr=True,
    protocol_config={'allow_all_attrs': True},
).start()
"
